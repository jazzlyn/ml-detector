{
  extends: [
    "github>techtales-io/renovate-config:base.json5",
    "github>techtales-io/renovate-config:python.json5",
    "github>techtales-io/renovate-config//github-actions/silent-automerge.json5",
    "github>techtales-io/renovate-config//pre-commit/silent-automerge.json5",
  ],
  packageRules: [
    {
      description: "torch: group",
      groupName: "torch",
      matchDatasources: ["pypi"],
      matchDepNames: ["torch", "pytorch-triton-xpu"],
      semanticCommitScope: "{{groupName}}",
      group: {
        semanticCommitScope: "{{groupName}}",
        commitMessageTopic: "group",
      },
    },
    {
      matchDatasources: ["pypi"],
      matchJsonata: ["managerData.depGroup = 'cpu'"],
      registryUrls: ["https://download.pytorch.org/whl/cpu"],
    },
    {
      matchDatasources: ["pypi"],
      matchJsonata: ["managerData.depGroup = 'cuda'"],
      registryUrls: ["https://download.pytorch.org/whl/cu128"],
    },
    // {
    //   description: "torch: exclude specific versions",
    //   matchDatasources: ["pypi"],
    //   matchDepNames: ["torch"],
    //   allowedVersions: "!/^2.9.0/",
    // },
    // {
    //   description: "torchvision: exclude specific versions",
    //   matchDatasources: ["pypi"],
    //   matchDepNames: ["torchvision"],
    //   allowedVersions: "!/^0.24.0/",
    // },
  ],
}
